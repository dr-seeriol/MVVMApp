<Window x:Class="DBApp.Views.AltMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltMainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- got rid of papyrus font for your viewing pleasure -->
        <TextBlock Grid.Row="0" Text="People" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="S_earch" Target="{Binding ElementName=SearchTextBox}" Padding="0,0,0,2"/>
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Sort by _Name" Padding="10,4" Margin="0,0,10,0"
                        Command="{Binding SortByNameCommand}"/>
                <Button Content="S_ort by Age" Padding="10,4"
                        Command="{Binding SortByAgeCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding SortStatus}" HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <ListBox x:Name="PeopleListBox" Grid.Row="3" Margin="0,0,0,10"
         ItemsSource="{Binding People}"
         SelectedItem="{Binding SelectedPerson, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FirstName}"/>
                        <TextBlock Text=" "/>
                        <TextBlock Text="{Binding LastName}"/>
                        <TextBlock Text=",  " />
                        <TextBlock Text="{Binding Age}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GroupBox Grid.Row="4" Header="Selected Person" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="_First Name" Target="{Binding ElementName=FirstNameTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="FirstNameTextBox"
                             Text="{Binding SelectedPerson.FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="_Last Name" Target="{Binding ElementName=LastNameTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="LastNameTextBox"
                             Text="{Binding SelectedPerson.LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="A_ge" Target="{Binding ElementName=AgeTextBox}" Padding="0,0,0,2"/>
                    <TextBox x:Name="AgeTextBox"
                             Text="{Binding SelectedPerson.Age, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button Content="_Add Person" Padding="10,4" Margin="0,0,10,0"
                    Command="{Binding AddPersonCommand}"/>
            <Button Content="_Delete Person" Padding="10,4" Margin="0,0,10,0"
                    Command="{Binding DeletePersonCommand}"/>
            <Button Content="_Save Changes" Padding="10,4"
                    Command="{Binding SaveChangesCommand}"/>
        </StackPanel>
    </Grid>
</Window>